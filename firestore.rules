rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil dan seluruh subkoleksi mahasiswa hanya dapat diakses oleh mahasiswa bersangkutan
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Koleksi pemetaan NIM untuk memastikan keunikan NIM mahasiswa
    match /nims/{nim} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // Master kurikulum: Mahasiswa yang terautentikasi dapat membaca data mata kuliah
    match /curriculum/{courseId} {
      allow read: if request.auth != null;
      allow write: if false; // Hanya admin atau fungsi backend
    }

    // Default deny untuk semua dokumen lainnya
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
